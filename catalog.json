        {
          "slug": "dart",
          "name": "Dart",
          "path": "override/ships/dart/",
          "frame_width": 104,
          "frame_height": 104,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The Consolidated Express Dart Freighter is the most massive ship ever built. It was designed at the end of the 21st century. But when ConEx put the ship out on the market, there was a high demand. The Dart Freighter's best defence is that it can outrun most ships, the only problem is its terrible acceleration."
        },
        {
          "slug": "defender",
          "name": "Defender",
          "path": "override/ships/defender/",
          "frame_width": 40,
          "frame_height": 40,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The Consolidated Express Defender is a weak combat ship. Made for those daring young souls who want to fight, this is the ship for them."
        },
        {
          "slug": "gryphon",
          "name": "Gryphon",
          "path": "override/ships/gryphon/",
          "frame_width": 48,
          "frame_height": 48,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The Consolidated Express Gryphon was originally designed as a carried fighter ship. Until the administration noticed that it was a very sturdy ship. Then they enlarged the ship by a factor of 3. It now holds a crew of 25, not 2 as the original."
        },
        {
          "slug": "trident",
          "name": "Trident",
          "path": "override/ships/trident/",
          "frame_width": 40,
          "frame_height": 40,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The Consolidated Express Trident Fighter was designed as a fighter ship for the ConEx shipping Company. This tiny little ship is a match for the UE Fighter"
        },
        {
          "slug": "necromancer",
          "name": "Necromancer",
          "path": "override/ships/necromancer/",
          "frame_width": 72,
          "frame_height": 72,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The Necromancer is a highly classified experimental government project. It is equipped with three Consolidated Arms Multi Phase Dimension Missile Repeaters (CAMPDeMR). The weapon is mounted on top of your ship's massive power cells. It converts your ship's energy into Consolidated Arms Multi Phase Dimension Mk. 83 smart guided missiles."
        },
        {
          "slug": "yodacon",
          "name": "Yodacon",
          "path": "override/ships/yodacon/",
          "frame_width": 96,
          "frame_height": 96,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The Consolidated Express Yodacon is the Biggest/Baddest ship of the ConEx fleet. This escort ship carries 15 tridents that are stored in 5 launch bays, for fast launching."
        },
        {
          "slug": "tomaquad",
          "name": "Tomaquad",
          "path": "override/ships/tomaquad/",
