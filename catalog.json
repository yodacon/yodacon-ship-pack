    {
      "key": "conex",
      "title": "ConEx 1.2",
      "year": 1997,
      "game": "Escape Velocity",
      "archive": "sources/ev/792_ConEx12.sit.hqx",
      "archive_sha256": "ded5fc0c7d9412ae174bd28a690d683fef65a571b809731ab626a31589aa4627",
      "plugin_modified": "1997-11-28T21:05:34",
      "path": "conex/",
      "ships": [
        {
          "slug": "small-pin",
          "name": "Small Pin",
          "path": "conex/ships/small-pin/",
          "frame_width": 36,
          "frame_height": 36,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The Small Pin is three times a Shuttlecraft in almost every way, and very easy to mass produce. Consolidated Express made this ship because they needed a ship that could outrun pirates, and still carry a reasonable amount of cargo."
        },
        {
          "slug": "medium-pin",
          "name": "Medium Pin",
          "path": "conex/ships/medium-pin/",
          "frame_width": 50,
          "frame_height": 50,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The Medium Pin is 3 times the Small Pin in almost every way. This ship is also easy to mass produce. It was made because Consolidated Express noticed how popular the Small Pin was, and the Small Pin didn't carry enough cargo for the bigger shipments."
        },
        {
          "slug": "large-pin",
          "name": "Large Pin",
          "path": "conex/ships/large-pin/",
          "frame_width": 65,
          "frame_height": 65,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The Large Pin is the most massive courier ship in the galaxy. It was made by Consolidated Express because the Small and the Medium Pin made huge profits."
        },
        {
          "slug": "dart",
          "name": "Dart",
          "path": "conex/ships/dart/",
          "frame_width": 80,
          "frame_height": 80,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The ConEx Dart is the most massive ship ever built. The design for it is a couple centuries old. But when ConEx put it out on the market, people were crazy to buy it. Its turning is a little above the bulk freighter, and the acceleration is terrible, but the Dart has one unique feature, it has a top speed the same as the Confederate Patrol Ship."
        },
        {
          "slug": "defender",
          "name": "Defender",
          "path": "conex/ships/defender/",
          "frame_width": 36,
          "frame_height": 36,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The ConEx Defender is mainly used as fighters for the Large Pin. There have been some that have been known to use this ship to fight against the confederation, alone. None have lived to tell a story. This ship is only powerful in numbers."
        },
        {
          "slug": "gryphon",
          "name": "Gryphon",
          "path": "conex/ships/gryphon/",
          "frame_width": 32,
          "frame_height": 32,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "This fast but little ship has great firepower for the buck."
        },
        {
          "slug": "trident",
          "name": "Trident",
          "path": "conex/ships/trident/",
          "frame_width": 35,
          "frame_height": 35,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": null
        },
        {
          "slug": "necromancer",
          "name": "Necromancer",
          "path": "conex/ships/necromancer/",
          "frame_width": 50,
          "frame_height": 50,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The Necromancer is a highly experimental government project. It is equipped with three A-75 Missile Repeaters. The weapon is mounted on top of your ship's power cells. Using the E=MC2 principle it converts your ship's power to Consolidated Arms Mk. 83 guided missiles."
        },
        {
          "slug": "yodacon",
          "name": "Yodacon",
          "path": "conex/ships/yodacon/",
          "frame_width": 70,
          "frame_height": 70,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The shape of this ship makes it one of the hardest ships in history to mass produce. When the plans were shown to High Command they immediately started building it, for they thought the galaxy needed a totally unique design."
        },
        {
          "slug": "tomaquad",
          "name": "Tomaquad",
          "path": "conex/ships/tomaquad/",
          "frame_width": 60,
          "frame_height": 60,
          "columns": 6,
          "frames": 36,
          "pictures": {
            "target": "target.png",
            "yard": "yard.png",
            "comm": "comm.png",
            "thumb": "thumb.png"
          },
          "description": "The Tomaquad is ConEx's version of the Luxury Liner."
        }
      ]
    },
